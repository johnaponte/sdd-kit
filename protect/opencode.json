{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      ".claude/**": "deny",
      ".opencode/**": "deny",
      ".agents/**": "deny",
      ".codex/**": "deny",
      "opencode.json": "deny",
      ".mcp.json": "deny",
      "bin/**": "deny",
      "docs/constitution.md": "deny",
      "AGENTS.md": "deny",
      "CLAUDE.md": "deny"
    },
    "bash": {
      "*": "allow",
      "chflags *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "xattr *": "deny",
      "sudo *": "deny",
      "docker *": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "gh *": "deny",
      "podman *": "deny",
      "bin/*--net*": "ask",
      "*sdd-kit*": "deny",
      "*promote.sh*": "deny",
      "*lock.sh*": "deny",
      "rm": "deny",
      "rm *": "deny",
      "unlink *": "deny",
      "shred *": "deny",
      "*-delete*": "deny"
    }
  }
}
